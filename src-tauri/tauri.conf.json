{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "douyin-danmu",
  "version": "0.3.0",
  "identifier": "com.douyindanmu.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gh-proxy.org/https://github.com/bd-dxg/douyin-danmu/releases/latest/download/latest.json",
        "https://cdn.gh-proxy.org/https://github.com/bd-dxg/douyin-danmu/releases/latest/download/latest.json",
        "https://v4.gh-proxy.org/https://github.com/bd-dxg/douyin-danmu/releases/latest/download/latest.json",
        "https://github.com/bd-dxg/douyin-danmu/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxQTE3ODc4NzUyOUExQ0IKUldUTG9TbDFlSGloUWVWbUZVeXZ6S3ArNTRkSWJYTlVLOFZCd0xGVHB1RTJmR1hsQ0dZYXdvcHMK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
